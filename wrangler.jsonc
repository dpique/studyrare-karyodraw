{
  // KaryoDraw: a static site plus a small Worker. The Worker (worker.js) serves
  // the static assets via the ASSETS binding and handles POST /api/collect,
  // which writes an anonymous, cookieless usage row to the D1 database below.
  // No build step here. ONE deploy path: .github/workflows/deploy.yml on push to main,
  // which runs `node scripts/build-pages.mjs` before `wrangler deploy` so the landing
  // pages and sitemap are regenerated from content/karyotypes.js, then pings IndexNow.
  //
  // Do NOT reconnect the Cloudflare Workers Builds Git integration without also setting
  // its build command. It was connected until 2026-08-08 with "Build command: None" and
  // watch paths "*", so it deployed every push, skipped the regeneration step, and
  // shipped whatever generated files happened to be committed. Both paths deployed each
  // push about a second apart and the later one won, so a content/karyotypes.js edit
  // committed without a rebuild would have gone live stale with every check green. It is
  // disconnected; this workflow is the only deploy path.
  "name": "studyrare-karyodraw",
  "compatibility_date": "2026-07-03",
  "main": "worker.js",
  // The default here (run_worker_first unset, i.e. false) means Cloudflare serves any
  // path matching a static asset from the asset layer and never invokes worker.js. The
  // www -> apex 301 added in #186 shipped under that default, so it ran on /api/* and on
  // 404s and on nothing else: every URL in sitemap.xml is a static asset, so the four
  // indexed spellings of every page stayed four. The unit tests called worker.fetch
  // directly and passed throughout.
  //
  // So HTML routes through the Worker and binaries do not. Negative patterns win over
  // positive ones and their order does not matter; `*` matches across path segments,
  // which is what keeps /karyotype/<slug>/karyogram.png (three deep) on the free asset
  // path. Excluding an extension is a billing decision, not a correctness one: anything
  // that does reach the Worker still falls through to env.ASSETS.fetch. test/seo.test.js
  // checks every sitemap URL against these patterns, so a new page shape that would be
  // served without ever reaching the redirect fails the build instead of going quiet.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/*.png", "!/*.svg", "!/*.ico", "!/*.js", "!/*.css",
      "!/*.json", "!/*.xml", "!/*.txt"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karyodraw-usage",
      "database_id": "a3ffb445-1e1c-47a9-9004-4d1ed257f58e"
    }
  ],
  // Daily feedback digest. 13:00 UTC is ~08:00 US Eastern. The scheduled handler
  // no-ops until RESEND_API_KEY and FEEDBACK_EMAIL_TO are set as secrets.
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  // Per-IP rate limits on the write endpoints (worker.js overLimit). Best-effort,
  // per-location counting, enough to stop a scripted flood from inflating D1
  // writes, poisoning the "Most-studied" board, or spamming the feedback inbox.
  // /api/collect is generous so a classroom behind one NAT IP is never blocked;
  // /api/feedback is tight because a real person submits it rarely. namespace_id
  // is an arbitrary per-limiter id within the account; period must be 10 or 60.
  "unsafe": {
    "bindings": [
      { "name": "RL_COLLECT", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
      { "name": "RL_FEEDBACK", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
    ]
  }
}
